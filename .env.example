PULP_BASE_URL=https://pulp.example.com
PULP_USERNAME=admin
PULP_PASSWORD=changeme
# PULP_API_VERSION=v3

# Optional branding. PULP_UI_CUSTOM_DIR holds templates that shadow the bundled
# ones (footer.html, any page) plus a static/ served at /custom-static, whose
# custom.css is loaded automatically. See the Branding section of the README.
# PULP_UI_CUSTOM_DIR=./custom
# PULP_UI_LOGO_URL=/custom-static/logo.svg
# PULP_UI_EXTRA_CSS_URL=https://cdn.example.com/pulp-ui.css

# uvicorn defaults to 8000; override if that port is taken locally.
UVICORN_PORT=8081
