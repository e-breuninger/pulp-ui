root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml,toml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
# ruff-format is the authority here. The generic multiple-of-indent_size rule
# also trips on wrapped prose inside docstrings, which is not an indent at all.
indent_size = unset

[*.py]
# ruff-format is the authority here. The generic multiple-of-indent_size
# rule also trips on wrapped prose inside docstrings, which is not an indent.
indent_size = unset
